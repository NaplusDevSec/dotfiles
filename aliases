# shellcheck shell=bash
# Shared by bash and zsh. Keep this file free of machine-specific or secret
# settings — those belong in ~/.bash_private or ~/.zsh_private (see private.example).

# ==============================================================================
# 1. CORE UTILITIES & SAFETY
# ==============================================================================
# Enable colored output for standard search commands
alias grep='grep --color=auto'
alias fgrep='grep -F --color=auto'  # fgrep/egrep are deprecated in GNU grep >= 3.8
alias egrep='grep -E --color=auto'

# Prompt for confirmation before overwriting or deleting files (Safety First)
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Clear terminal screen
alias cls='clear'

# ==============================================================================
# 2. NAVIGATION & FILE LISTING
# ==============================================================================
# Base directory listing color settings
alias ls='ls --color=auto'

# Tree structure visualization with pagination (preserves ANSI colors)
alias tl='tree -C | less -R'             # Interactive tree view
alias tla='tree -Ca | less -R'           # Interactive tree view (including hidden files)

# Detailed file listings
alias l='ls -CF'                           # Compact column view with file type indicators
alias ll='ls -ilAFHh --full-time'          # Detailed list with hidden files, inodes, and timestamps
alias lt='ls -ltAFHh'                      # List sorted by modification time (newest first)
alias LS='ls -lSAFHh'                      # List sorted by file size (largest first)

# Quick directory navigation (dots count = parent level up)
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# ==============================================================================
# 3. DISK & STORAGE MONITORING
# ==============================================================================
alias fdl='sudo fdisk -l'           # List all disk partitions
alias dfh='df -Th'                  # Show disk space usage with file system types
alias dfi='df -iT'                  # Show inode usage

# Check directory sizes, sorted by size (human-readable)
alias dus='du -sh'                         # Summary size of the current directory only
alias du1='du -h --max-depth=1 | sort -h' # Subdirectory sizes (depth 1)
alias du2='du -h --max-depth=2 | sort -h' # Subdirectory sizes (depth 2)
alias du3='du -h --max-depth=3 | sort -h' # Subdirectory sizes (depth 3)

# ==============================================================================
# 4. NETWORKING
# ==============================================================================
# Fetch and print the public IP address of this machine
alias myip='curl -fsS --max-time 5 https://ifconfig.me && echo'

# ==============================================================================
# 5. C DEVELOPMENT & 42 SCHOOL
# ==============================================================================
# Strict compilation flags (42 Norminette standard)
alias cw='cc -Wall -Wextra -Werror'
alias gcw='cc -g -Wall -Wextra -Werror'   # Include debugging symbols

# Standard Valgrind memory leak checking
alias vg='DEBUGINFOD_URLS="" valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes'

# Valgrind + GDB Debugger integration
# Automatically runs Valgrind in the background and attaches GDB to it
vgdb() {
    local target="${1:-./a.out}"
    DEBUGINFOD_URLS="" valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --vgdb=yes --vgdb-error=0 "$target" > /dev/null 2>&1 &
    local vg_pid=$!
    sleep 0.5
    gdb -ex "target remote | vgdb --pid=$vg_pid" -ex "layout src" -ex "b main" -ex "c" "$target"
    kill -9 $vg_pid 2>/dev/null
    wait $vg_pid 2>/dev/null
}

# ==============================================================================
# 6. MODERN CLI TOOLS (bat, fd, rg)
# ==============================================================================
# Syntax-highlighted cat replacement (bat)
if command -v bat >/dev/null 2>&1; then
    alias b='bat'                          # Full bat output with syntax highlighting and pager
    alias bb='bat --style=plain --paging=never' # Plain text output without borders or pager
fi

# Fast directory entry finder (fd)
if command -v fd >/dev/null 2>&1; then
    alias fda='fd --hidden --no-ignore'    # Search all files (including hidden & ignored)
fi

# Fast line-oriented search tool (ripgrep)
if command -v rg >/dev/null 2>&1; then
    alias ripgrep='rg'                     # Explicit command alias for rg
    alias rgi='rg -i'                      # Case-insensitive search
    alias rga='rg --hidden --no-ignore'    # Search inside all files (including hidden & ignored)
fi
